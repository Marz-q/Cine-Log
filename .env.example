# ==============================================================================
# Cine-Log Environment Configuration Example
# Copy this file to .env and configure your local environment settings.
# ==============================================================================

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cinelog
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# TMDB (The Movie Database) API
# Get your free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# Security & JWT Token Signing
# Use a secure random string of at least 256 bits (32+ characters)
JWT_SECRET=CineLogSecretKeyForJwtSigningMustBeAtLeast256BitsLongForHmacSha256Security1234567890
JWT_EXPIRATION_MS=86400000

# AI Microservice URL (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Frontend API URL
VITE_API_URL=http://localhost:8080/api

# Groq AI Chatbot API Key
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
